   # Токен бота от @BotFather. Нужен HTTP-запросам к Telegram API (getUpdates и др.)
TELEGRAM_BOT_TOKEN=123456789:paste-token-from-BotFather
      # Ключ Gemini API из Google AI Studio. Нужен скриптам вне n8n (scripts/gemini-try.js);
   # сами ноды n8n берут ключ из своего credential.
GEMINI_API_KEY=paste-key-from-ai-studio
   # Твой chat_id в Telegram (число из getUpdates): куда бот шлёт вакансии и алерты
   TELEGRAM_CHAT_ID=123456789